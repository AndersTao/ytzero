      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvem ser med?"
          }
        }
      }
    },
    "Each profile signs in on its own: Add profile shows a code to approve on the phone of the person being added. Hold a profile to remove it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver profil logger ind for sig: Tilføj profil viser en kode, som godkendes på telefonen hos den, der tilføjes. Hold en profil nede for at fjerne den."
          }
        }
      }
    },
