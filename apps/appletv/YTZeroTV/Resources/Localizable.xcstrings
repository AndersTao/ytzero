      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbereder video…"
          }
        }
      }
    },
    "Press Menu to go back.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Menu for at gå tilbage."
          }
        }
      }
    },
