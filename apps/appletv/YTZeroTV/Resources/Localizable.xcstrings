{
  "sourceLanguage": "en",
  "strings": {
    "%@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind"
          }
        }
      }
    },
    "Connect to YT Zero": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind til YT Zero"
          }
        }
      }
    },
    "Continue watching": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt med at se"
          }
        }
      }
    },
    "Enter the address of your YT Zero server, for example ytzero.example.com.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv adressen på din YT Zero-server, fx ytzero.example.com."
          }
        }
      }
    },
    "Main": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Main"
          }
        }
      }
    },
    "Mark as watched": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér som set"
          }
        }
      }
    },
    "Marked as watched": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeret som set"
          }
        }
      }
    },
    "No new videos": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nye videoer"
          }
        }
      }
    },
    "No YT Zero server answered at that address.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen YT Zero-server svarede på den adresse."
          }
        }
      }
    },
    "Or go to %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller gå til %@"
          }
        }
      }
    },
